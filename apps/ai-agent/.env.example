DATABASE_URL=postgresql://fleet:fleet@localhost:5434/fleet_telemetry

# Selección de proveedor de LLM — ver src/providers/factory.ts
# "ollama" (default): gratis, local, no requiere key
# "openai": de pago, requiere OPENAI_API_KEY
LLM_PROVIDER=ollama

# --- Configuración Ollama (usada si LLM_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Configuración OpenAI (usada si LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # opcional: para Azure OpenAI, OpenRouter, etc.

PORT=3002
