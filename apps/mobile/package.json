    "expo-location": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
