{
  "name": "@fleet/mobile",
  "version": "1.0.1",
  "private": true,
  "description": "App del conductor (React Native/Expo, offline-first). Ver README.md para el estado del scaffold y las brechas documentadas.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
