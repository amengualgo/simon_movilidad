# Selección de proveedor del agente de IA — ver apps/ai-agent/src/providers/factory.ts
# LLM_PROVIDER=ollama (default, gratis, local, no requiere key)
# LLM_PROVIDER=openai (de pago, requiere OPENAI_API_KEY)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Nota: con LLM_PROVIDER=openai, docker-compose.yml igual levanta el
# contenedor "ollama" por defecto (queda inactivo, sin usarse). Si quieres
# evitarlo, comenta el servicio "ollama" y su "depends_on" en ai-agent.
